# Copy this file to .env and fill in what you need. .env is git-ignored.

# Which LLM writes the answers: auto | ollama | openai | anthropic | extractive
# "auto" uses Anthropic if its key is set, then OpenAI, then a running Ollama,
# and otherwise falls back to the free extractive mode (no LLM).
LLM_PROVIDER=auto
# Leave empty to use the provider's default (see config.py)
LLM_MODEL=

# Local and free: install Ollama, then `ollama pull qwen3:8b`
OLLAMA_HOST=http://localhost:11434

# Any OpenAI-compatible API. For Groq's free tier, for example:
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_BASE_URL=

ANTHROPIC_API_KEY=

# Optional overrides (models can also be local folders)
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# QASPER_PARQUET=/path/to/validation.parquet
